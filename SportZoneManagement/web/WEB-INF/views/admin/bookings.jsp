<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Booking Admin — SportZone" scope="request"/>
<c:set var="pageCss" value="admin-design.css" scope="request"/>
<c:set var="pageBodyClass" value="sz-page-admin" scope="request"/>
<c:set var="headerVariant" value="none" scope="request"/>
<c:set var="footerVariant" value="none" scope="request"/>
<c:set var="adminSection" value="bookings" scope="request"/>
<jsp:include page="/WEB-INF/views/layout/header.jsp"/>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<div class="admin-layout"><jsp:include page="/WEB-INF/views/layout/admin-sidebar.jsp"/><div class="admin-content">
    <header class="admin-topbar"><button class="topbar-toggle" id="topbarToggle" type="button">☰</button><div class="topbar-title">Booking Operations</div><div class="topbar-actions"><a class="btn-admin-primary" href="${ctx}/MainController?action=bookingCreate">+ Tạo Booking Vãng Lai</a></div></header>
    <main class="admin-main-scroll"><section class="admin-view active">
        <c:if test="${not empty success}"><div class="admin-alert success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="admin-alert danger"><c:out value="${error}"/></div></c:if>
        <c:choose><c:when test="${empty booking}">
            <div class="admin-pagehead"><div><span class="page-eyebrow">BOOKING CONTROL CENTER</span><h1>Danh Sách Booking Toàn Hệ Thống</h1><p>Theo dõi, lọc và xử lý trạng thái check-in của khách hàng.</p></div><a class="btn-admin-primary" href="${ctx}/MainController?action=bookingCreate">+ Booking Vãng Lai</a></div>
            <form method="get" action="${ctx}/MainController" class="admin-filterbar"><input type="hidden" name="action" value="adminBookings"><label for="bookingStatus">Trạng thái</label><select id="bookingStatus" class="admin-select" name="status"><option value="all">Tất cả trạng thái</option><option value="Pending" ${selectedStatus == 'Pending' ? 'selected' : ''}>Pending</option><option value="Confirmed" ${selectedStatus == 'Confirmed' ? 'selected' : ''}>Confirmed</option><option value="CheckedIn" ${selectedStatus == 'CheckedIn' ? 'selected' : ''}>CheckedIn</option><option value="Completed" ${selectedStatus == 'Completed' ? 'selected' : ''}>Completed</option><option value="Cancelled" ${selectedStatus == 'Cancelled' ? 'selected' : ''}>Cancelled</option><option value="NoShow" ${selectedStatus == 'NoShow' ? 'selected' : ''}>NoShow</option></select><button class="btn-admin-secondary" type="submit">Áp Dụng Bộ Lọc</button></form>
            <section class="admin-panel"><div class="panel-head"><div><h2>Booking Registry</h2><p>Dữ liệu booking thực tế từ hệ thống</p></div><span class="record-count">${bookingList.size()} booking</span></div><div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã</th><th>Khách Hàng</th><th>Sân</th><th>Ngày &amp; Giờ</th><th>Tổng Tiền</th><th>Trạng Thái</th><th></th></tr></thead><tbody><c:forEach var="item" items="${bookingList}"><tr><td><span class="mono">#BK-${item.bookingId}</span></td><td><div class="customer-cell"><span class="customer-avatar">KH</span><strong><c:out value="${item.accountName}"/></strong></div></td><td><strong><c:out value="${item.courtName}"/></strong></td><td><fmt:formatDate value="${item.slotDateValue}" pattern="dd/MM/yyyy"/><br><small>${item.startTime} – ${item.endTime}</small></td><td class="amount"><fmt:formatNumber value="${item.totalAmount}" groupingUsed="true"/> đ</td><td><span class="status-pill status-${item.status}">${item.status}</span></td><td><a class="table-action" href="${ctx}/MainController?action=adminBookings&amp;id=${item.bookingId}">Xem Chi Tiết</a></td></tr></c:forEach><c:if test="${empty bookingList}"><tr><td colspan="7"><div class="admin-empty">Không có booking phù hợp bộ lọc.</div></td></tr></c:if></tbody></table></div></section>
        </c:when><c:otherwise>
            <div class="admin-pagehead"><div><a class="admin-back" href="${ctx}/MainController?action=adminBookings">← Quay lại danh sách</a><span class="page-eyebrow">BOOKING #${booking.bookingId}</span><h1><c:out value="${booking.accountName}"/></h1><p>Chi tiết lịch chơi và trạng thái vận hành.</p></div><span class="status-pill status-${booking.status}">${booking.status}</span></div>
            <div class="admin-detail-grid"><section class="admin-panel"><div class="panel-head"><div><h2>Thông Tin Booking</h2><p>Dữ liệu đơn đặt sân</p></div></div><div class="admin-kv"><span>Khách hàng</span><strong><c:out value="${booking.accountName}"/> <c:if test="${booking.accountRoleName == 'Admin'}"><small>(Khách vãng lai)</small></c:if></strong></div><div class="admin-kv"><span>Sân thi đấu</span><strong><c:out value="${booking.courtName}"/></strong></div><div class="admin-kv"><span>Buổi chơi</span><strong><fmt:formatDate value="${booking.slotDateValue}" pattern="dd/MM/yyyy"/> · ${booking.startTime}–${booking.endTime}</strong></div><div class="admin-kv"><span>Tổng tiền</span><strong><fmt:formatNumber value="${booking.totalAmount}" groupingUsed="true"/> đ</strong></div><div class="admin-kv"><span>Thanh toán</span><strong>${empty booking.paymentStatus ? 'Chưa có hóa đơn' : booking.paymentStatus}</strong></div><c:if test="${not empty booking.checkInAt}"><div class="admin-kv"><span>Check-in lúc</span><strong>${booking.checkInAt}</strong></div></c:if></section>
                <aside class="admin-panel action-panel"><div class="panel-head"><div><h2>Thao Tác Vận Hành</h2><p>Chỉ hiển thị action hợp lệ</p></div></div><c:if test="${canCheckIn}"><form method="post" action="${ctx}/MainController?action=adminBookings"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="operation" value="checkIn"><input type="hidden" name="bookingId" value="${booking.bookingId}"><button class="btn-admin-primary full" type="submit">Check-in Khách</button></form></c:if><c:if test="${booking.accountRoleName == 'Admin' && booking.accountId == sessionScope.account.accountID}"><c:choose><c:when test="${booking.paymentStatus == 'Paid'}"><a class="btn-admin-secondary full" href="${ctx}/MainController?action=invoiceDetail&amp;bookingId=${booking.bookingId}">Xem Hóa Đơn</a></c:when><c:when test="${booking.paymentStatus != 'Cancelled'}"><a class="btn-admin-secondary full" href="${ctx}/MainController?action=invoicePayment&amp;bookingId=${booking.bookingId}">Thanh Toán QR</a></c:when></c:choose></c:if><c:if test="${!canCheckIn}"><div class="action-note">Check-in chỉ mở từ 30 phút trước đến trước 30 phút sau giờ bắt đầu.</div></c:if><div class="locked-actions"><span class="coming-badge">Coming Soon</span><button type="button" disabled>Manual No Show</button><button type="button" disabled>Check-out</button><button type="button" disabled>Refund</button></div></aside>
            </div>
        </c:otherwise></c:choose>
    </section></main>
</div></div>
<script>(function(){var sidebar=document.getElementById('adminSidebar');function toggle(){sidebar.classList.toggle('collapsed');document.body.classList.toggle('sidebar-collapsed');}document.getElementById('sidebarToggle').addEventListener('click',toggle);document.getElementById('topbarToggle').addEventListener('click',toggle);})();</script>
<jsp:include page="/WEB-INF/views/layout/footer.jsp"/>
