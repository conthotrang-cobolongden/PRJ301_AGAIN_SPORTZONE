<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!--
        Filter order is intentional:
        1. EncodingFilter
        2. AuthFilter
        3. FrozenAccountFilter
        4. RoleFilter
    -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>filter.EncodingFilter</filter-class>
    </filter>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filter.AuthFilter</filter-class>
    </filter>
    <filter>
        <filter-name>FrozenAccountFilter</filter-name>
        <filter-class>filter.FrozenAccountFilter</filter-class>
    </filter>
    <filter>
        <filter-name>RoleFilter</filter-name>
        <filter-class>filter.RoleFilter</filter-class>
    </filter>

    <!-- UTF-8 applies to public and protected routes. -->
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!--
        Authentication is required only for account, booking,
        invoice and admin functions.

        Phase 3 actions courts and court are intentionally public.
    -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/MainController</url-pattern>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!--
        Frozen account chi duoc xem account-locked,
        logout va static assets.
    -->
    <filter-mapping>
        <filter-name>FrozenAccountFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Admin authorization applies only to /admin/*. -->
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- ===== PUBLIC FOUNDATION SERVLETS ===== -->

    <servlet>
        <servlet-name>MainController</servlet-name>
        <servlet-class>controller.MainController</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>controller.HomeServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>controller.HealthServlet</servlet-class>
    </servlet>

    <!-- ===== PHASE 3: PUBLIC COURT BROWSING — U7 ===== -->

    <servlet>
        <servlet-name>CourtsServlet</servlet-name>
        <servlet-class>controller.CourtsServlet</servlet-class>
    </servlet>

    <!-- ===== PHASE 3: COURT DETAIL + SCHEDULE — U8, U9 ===== -->

    <servlet>
        <servlet-name>CourtDetailServlet</servlet-name>
        <servlet-class>controller.CourtDetailServlet</servlet-class>
    </servlet>

    <!-- ===== PHASE 2: AUTHENTICATION ===== -->

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>controller.RegisterServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>

    <!-- ===== PHASE 4: PROFILE — U4, U5, U6 ===== -->

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>controller.ProfileServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>PasswordServlet</servlet-name>
        <servlet-class>controller.PasswordServlet</servlet-class>
    </servlet>

    <!-- ===== PHASE 5: USER BOOKING — U10, U11, U12 ===== -->

    <servlet>
        <servlet-name>BookingCreateServlet</servlet-name>
        <servlet-class>controller.BookingCreateServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>BookingsServlet</servlet-name>
        <servlet-class>controller.BookingsServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>BookingDetailServlet</servlet-name>
        <servlet-class>controller.BookingDetailServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AccountLockedServlet</servlet-name>
        <servlet-class>controller.AccountLockedServlet</servlet-class>
    </servlet>

    <!-- ===== PHASE 6: SIMULATED USER PAYMENT + PAID INVOICES ===== -->

    <servlet>
        <servlet-name>InvoicePaymentServlet</servlet-name>
        <servlet-class>controller.InvoicePaymentServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>InvoicesServlet</servlet-name>
        <servlet-class>controller.InvoicesServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>InvoiceDetailServlet</servlet-name>
        <servlet-class>controller.InvoiceDetailServlet</servlet-class>
    </servlet>

    <!-- ===== ADMIN MVP: named dispatch targets only ===== -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>controller.AdminDashboardServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminCourtsServlet</servlet-name>
        <servlet-class>controller.AdminCourtsServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>AdminBookingsServlet</servlet-name>
        <servlet-class>controller.AdminBookingsServlet</servlet-class>
    </servlet>

    <!-- ===== PUBLIC ROUTE MAPPINGS ===== -->

    <servlet-mapping>
        <servlet-name>MainController</servlet-name>
        <url-pattern>/MainController</url-pattern>
    </servlet-mapping>

    <!-- Session expires after 30 minutes of inactivity. -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ===== ERROR PAGES ===== -->

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/403.jsp</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
